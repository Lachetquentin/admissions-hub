{
  "name": "admissions-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @admissions-hub/api\" \"npm run dev -w @admissions-hub/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:generate": "npm run db:generate -w @admissions-hub/api",
    "db:migrate": "npm run db:migrate -w @admissions-hub/api",
    "db:seed": "npm run db:seed -w @admissions-hub/api",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
