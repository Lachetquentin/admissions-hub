# Copy to .env (never commit .env). Validated at API startup by apps/api/src/config/env.ts.

# --- API ---
NODE_ENV=development
PORT=3000
# Public URL of the web app (CORS origin, and where the Salesforce callback sends users back).
APP_URL=http://localhost:5173

# PostgreSQL (docker compose up -d db exposes it on 5432)
DATABASE_URL=postgres://admissions:admissions@localhost:5432/admissions
# Separate database used by the integration tests (wiped on each run).
DATABASE_URL_TEST=postgres://admissions:admissions@localhost:5432/admissions_test

# JWT signing secret: at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h

# --- Salesforce (see README, "Salesforce configuration") ---
# false: Salesforce is switched off cleanly (sync and connect answer 503, the UI says so).
SALESFORCE_ENABLED=false
# https://login.salesforce.com for Developer Edition / production orgs, https://test.salesforce.com for sandboxes.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Consumer key and secret of the External Client App (OAuth settings).
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Must match the callback URL declared in the External Client App exactly.
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/integrations/salesforce/callback
SALESFORCE_API_VERSION=v62.0
# 32 random bytes, base64. Encrypts the Salesforce tokens stored in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
